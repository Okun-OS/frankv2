generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @default("Felix Okun")
  company   String   @default("OKUN Systems")
  role      String   @default("Founder & CEO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KPI {
  id          String     @id @default(cuid())
  name        String
  category    String
  unit        String
  target      Float
  current     Float      @default(0)
  previous    Float      @default(0)
  trend       String     @default("up")
  period      String     @default("MTD")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  values      KPIValue[]
}

model KPIValue {
  id        String   @id @default(cuid())
  kpiId     String
  kpi       KPI      @relation(fields: [kpiId], references: [id])
  value     Float
  date      DateTime @default(now())
  note      String?
}

model Goal {
  id           String      @id @default(cuid())
  title        String
  description  String?
  category     String
  status       String      @default("active")
  priority     Int         @default(1)
  targetValue  Float?
  currentValue Float?      @default(0)
  unit         String?
  deadline     DateTime?
  progress     Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  milestones   Milestone[]
}

model Milestone {
  id        String    @id @default(cuid())
  goalId    String
  goal      Goal      @relation(fields: [goalId], references: [id])
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

model Bottleneck {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  impact      String   @default("medium")
  status      String   @default("open")
  area        String
  duration    String?
  actions     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  potential   String   @default("medium")
  timeframe   String?
  status      String   @default("identified")
  area        String
  actions     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Strategy {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  type        String   @default("strategy")
  status      String   @default("active")
  priority    Int      @default(1)
  hypothesis  String?  @db.Text
  result      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyPlan {
  id        String      @id @default(cuid())
  date      DateTime    @default(now())
  progress  Float       @default(0)
  note      String?
  tasks     DailyTask[]
  createdAt DateTime    @default(now())
}

model DailyTask {
  id        String    @id @default(cuid())
  planId    String
  plan      DailyPlan @relation(fields: [planId], references: [id])
  title     String
  startTime String
  endTime   String
  category  String    @default("work")
  completed Boolean   @default(false)
  priority  Int       @default(1)
  color     String    @default("#3b82f6")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        String   @default("meeting")
  location    String?
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
}

model ContentItem {
  id          String    @id @default(cuid())
  title       String
  body        String?   @db.Text
  platform    String
  type        String
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  tags        String?
  metrics     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Memory {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  category   String
  tags       String?
  importance Int      @default(1)
  source     String?
  createdAt  DateTime @default(now())
}

model Alert {
  id          String   @id @default(cuid())
  title       String
  description String?
  severity    String   @default("info")
  category    String
  isRead      Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())
}

model Agent {
  id        String    @id @default(cuid())
  name      String
  type      String
  status    String    @default("active")
  lastRun   DateTime?
  config    String?   @db.Text
  createdAt DateTime  @default(now())
}

model Review {
  id             String   @id @default(cuid())
  weekNumber     Int
  year           Int
  title          String
  wins           String?  @db.Text
  losses         String?  @db.Text
  learnings      String?  @db.Text
  nextWeekFocus  String?  @db.Text
  kpiSnapshot    String?  @db.Text
  createdAt      DateTime @default(now())
}

model Automation {
  id        String    @id @default(cuid())
  name      String
  trigger   String
  condition String?
  action    String
  isActive  Boolean   @default(true)
  lastRun   DateTime?
  createdAt DateTime  @default(now())
}

model Integration {
  id        String    @id @default(cuid())
  name      String
  type      String
  status    String    @default("disconnected")
  config    String?   @db.Text
  lastSync  DateTime?
  createdAt DateTime  @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String   @db.Text
  context   String?  @db.Text
  createdAt DateTime @default(now())
}

model OAuthToken {
  id           String    @id @default(cuid())
  provider     String    // google, instagram, linkedin
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  email        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model IncomingEmail {
  id          String   @id @default(cuid())
  gmailId     String   @unique
  threadId    String?
  from        String
  fromName    String?
  subject     String
  snippet     String?
  body        String   @db.Text
  receivedAt  DateTime
  category    String   @default("uncategorized") // lead, customer, review, support, spam, newsletter
  priority    String   @default("normal")         // high, normal, low
  sentiment   String?                              // positive, neutral, negative
  isRead      Boolean  @default(false)
  isProcessed Boolean  @default(false)
  aiSummary   String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())
}

model WebhookEvent {
  id          String   @id @default(cuid())
  source      String   // dealsky, instagram, linkedin, stripe, custom
  eventType   String
  payload     String   @db.Text
  processed   Boolean  @default(false)
  error       String?  @db.Text
  createdAt   DateTime @default(now())
}

model SocialMetric {
  id          String   @id @default(cuid())
  platform    String   // instagram, linkedin
  postId      String?
  type        String   // post, story, comment, follower_update, message
  content     String?  @db.Text
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  engagement  Float    @default(0)
  publishedAt DateTime?
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())
}

model DealEvent {
  id           String   @id @default(cuid())
  source       String   @default("dealsky")
  dealId       String?
  dealName     String?
  stage        String?
  value        Float?
  currency     String   @default("EUR")
  contactName  String?
  contactEmail String?
  eventType    String   // deal_created, stage_changed, deal_won, deal_lost, note_added
  note         String?  @db.Text
  metadata     String?  @db.Text
  createdAt    DateTime @default(now())
}
